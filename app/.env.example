# Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Postgres, direct connection (Connect button, Direct connection URI).
# Used by API route handlers.
DATABASE_URL=

# Google AI Studio key (https://aistudio.google.com/apikey).
# Both names get the same value: the @google/genai SDK reads GEMINI_API_KEY,
# the Vercel AI SDK reads GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
